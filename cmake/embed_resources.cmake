# embed_resources.cmake
# Called via execute_process at configure time:
#   cmake -DDIST_DIR=<abs>
#         -DRC_OUTPUT=<abs>   (Windows RC file)
#         -DMAP_OUTPUT=<abs>  (shared URL->ID map + mime helper)
#         -DCC_OUTPUT=<abs>   (Linux byte-array definitions)
#         -DCHH_OUTPUT=<abs>  (Linux byte-array declarations)
#         -P embed_resources.cmake
#
# Always generates all four files; the build system decides which to compile.

if(NOT EXISTS "${DIST_DIR}")
    message(FATAL_ERROR
        "embed_resources.cmake: DIST_DIR does not exist: ${DIST_DIR}\n"
        "Run 'ng build' inside the frontend/ folder first.")
endif()

file(GLOB_RECURSE dist_files
    LIST_DIRECTORIES false
    "${DIST_DIR}/*"
)

# ── Windows RC file ───────────────────────────────────────────────────────────
set(rc  "// Auto-generated by cmake/embed_resources.cmake – do not edit.\n")
set(rc  "${rc}// Re-run CMake after every 'ng build' to pick up new hashed filenames.\n\n")

# ── Shared URL→{ID,MIME} map (included by frontend_server.cc always) ─────────
set(hh  "// Auto-generated by cmake/embed_resources.cmake – do not edit.\n")
set(hh  "${hh}#pragma once\n\n")
set(hh  "${hh}#include <string>\n")
set(hh  "${hh}#include <string_view>\n")
set(hh  "${hh}#include <unordered_map>\n\n")
set(hh  "${hh}struct ResourceRef { int id; std::string_view mime; };\n\n")
set(hh  "${hh}inline const std::unordered_map<std::string, ResourceRef> RESOURCE_MAP = {\n")

# ── Linux: byte-array declaration header ─────────────────────────────────────
set(chh "// Auto-generated by cmake/embed_resources.cmake – do not edit.\n")
set(chh "${chh}#pragma once\n\n")
set(chh "${chh}#include <cstddef>\n")
set(chh "${chh}#include <unordered_map>\n\n")
set(chh "${chh}struct ResourceEntry { const unsigned char* data; std::size_t size; };\n\n")
set(chh "${chh}extern const std::unordered_map<int, ResourceEntry> RESOURCE_DATA;\n")

# ── Linux: byte-array definition source ──────────────────────────────────────
set(cc  "// Auto-generated by cmake/embed_resources.cmake – do not edit.\n")
set(cc  "${cc}#include \"resources_data.hh\"\n\n")

set(id 101)
set(data_entries "")   # accumulate RESOURCE_DATA entries

foreach(abs_path ${dist_files})
    file(RELATIVE_PATH rel "${DIST_DIR}" "${abs_path}")
    string(REPLACE "\\" "/" url_path "/${rel}")
    string(REPLACE "\\" "/" rc_path  "${abs_path}")

    # ── Derive MIME from the actual file extension ──
    get_filename_component(ext "${rel}" EXT)
    if(ext STREQUAL ".html")
        set(mime "text/html")
    elseif(ext STREQUAL ".js")
        set(mime "application/javascript")
    elseif(ext STREQUAL ".css")
        set(mime "text/css")
    elseif(ext STREQUAL ".ico")
        set(mime "image/x-icon")
    elseif(ext STREQUAL ".json")
        set(mime "application/json")
    elseif(ext STREQUAL ".txt")
        set(mime "text/plain")
    else()
        set(mime "application/octet-stream")
    endif()

    # ── RC entry ──
    set(rc  "${rc}${id}  RCDATA  \"${rc_path}\"\n")

    # ── URL map entries (ID + MIME baked in from the real filename) ──
    set(hh  "${hh}    {\"${url_path}\", {${id}, \"${mime}\"}},\n")
    if(rel STREQUAL "index.html")
        set(hh "${hh}    {\"/\", {${id}, \"${mime}\"}},\n")
    endif()

    # ── C++ byte array ──
    file(READ "${abs_path}" hex HEX)
    # Insert "0x" before every two hex digits and a trailing comma
    string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1," hex_bytes "${hex}")
    set(cc "${cc}static const unsigned char _res_${id}[] = { ${hex_bytes} };\n")
    set(data_entries "${data_entries}    {${id}, {_res_${id}, sizeof(_res_${id})}},\n")

    math(EXPR id "${id} + 1")
endforeach()

# Close URL map
set(hh "${hh}};\n")

# Close RESOURCE_DATA map
set(cc "${cc}\nconst std::unordered_map<int, ResourceEntry> RESOURCE_DATA = {\n")
set(cc "${cc}${data_entries}")
set(cc "${cc}};\n")

file(WRITE "${RC_OUTPUT}"  "${rc}")
file(WRITE "${MAP_OUTPUT}" "${hh}")
file(WRITE "${CHH_OUTPUT}" "${chh}")
file(WRITE "${CC_OUTPUT}"  "${cc}")

message(STATUS "embed_resources: generated RC, map header, and C++ data files")
